{
  "manifest_version": 3,
  "name": "KeySourceCheck",
  "version": "1.0.0",
  "description": "Find leaked API keys and secrets in website source code",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["<all_urls>", "http://localhost:11434/*"],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/extractor.js"],
      "run_at": "document_start",
      "all_frames": false,
      "type": "module"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": []
}
