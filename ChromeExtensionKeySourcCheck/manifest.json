{
  "manifest_version": 3,
  "name": "KeySourceCheck",
  "version": "1.0.0",
  "description": "Detects leaked API keys and secrets in website source code",
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeySourceCheck",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
 "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/shared/ui.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/shared/ui.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "http://localhost:11434/*"
  ]
}